generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// tip: "persoana-fizica" | "firma" | "agentie" (validat în aplicație, vezi TipUtilizator)
model Utilizator {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  tip                  String
  /// Persoană fizică: numele complet. Firmă/agenție: denumirea.
  nume                 String
  /// Persoana de contact, doar pentru firme și agenții.
  contact              String?
  email                String?           @unique
  parolaHash           String?
  telefon              String
  judet                String
  oras                 String
  cui                  String?
  /// Nr. Registrul Comerțului, pentru facturile firmelor și agențiilor.
  regCom               String?
  /// Adresa de facturare (stradă, număr), obligatorie pe e-Factura pentru firme.
  adresa               String?
  culoare              String            @default("#0b6bcb")
  creatLa              DateTime          @default(now())
  /// Agenție Fondatoare: una din primele 100 de agenții înscrise până la 31.12.2026.
  fondator             Boolean           @default(false)
  /// Până când abonamentul de agenție e gratuit (6 luni pentru fondatori).
  gratuitPanaLa        DateTime?
  /// Cine l-a recomandat (link ?ref=slug).
  recomandatDeId       String?
  recomandatDe         Utilizator?       @relation("Recomandari", fields: [recomandatDeId], references: [id], onDelete: SetNull)
  recomandari          Utilizator[]      @relation("Recomandari")
  /// Zile de promovare câștigate (7 zile la fiecare 3 recomandări).
  zilePromovare        Int               @default(0)
  /// Luni gratuite primite pentru agenții aduse (maximum 6).
  luniBonus            Int               @default(0)
  /// De unde a venit la înscriere (utm_source, recomandare, site de proveniență sau direct).
  sursa                String?
  /// Abonamentul de agenție plătit (start | pro | business | nelimitat), activ până la abonamentPanaLa.
  abonament            String?
  abonamentPanaLa      DateTime?
  plataAnuala          Boolean           @default(false)
  /// Credite de promovare rămase luna aceasta; se reîncarcă la crediteReincarcareLa.
  creditReactualizari  Int               @default(0)
  creditTop            Int               @default(0)
  crediteReincarcareLa DateTime?
  anunturi             Anunt[]
  sesiuni              Sesiune[]
  invitatie            InvitatieAgentie?
  facturi              Factura[]
  comenzi              Comanda[]

  @@index([tip, judet])
}

model Anunt {
  id                  Int        @id @default(autoincrement())
  titlu               String
  descriere           String
  /// apartament | casa | teren | spatiu-comercial
  tip                 String
  /// vanzare | inchiriere
  tranzactie          String
  /// Euro; pentru închiriere, pe lună.
  pret                Int
  suprafata           Int
  camere              Int?
  judet               String
  oras                String
  zona                String
  imagine             String
  publicatLa          DateTime   @default(now())
  /// Anunțul e public cât timp expiraLa e în viitor (60 de zile, cu prelungire).
  expiraLa            DateTime   @default(dbgenerated("(now() + '60 days'::interval)"))
  /// Cheia de ordonare în liste: data publicării sau a ultimei reactualizări.
  ordine              DateTime   @default(now())
  /// Promovări active până la data respectivă.
  evidentiatPanaLa    DateTime?
  topPanaLa           DateTime?
  primaPaginaPanaLa   DateTime?
  /// Pachetul „Vânzare rapidă”: reactualizări automate, una pe săptămână.
  reactualizariRamase Int        @default(0)
  urmReactualizare    DateTime?
  /// ok | verificare | respins. Doar „ok” apare pe site.
  moderare            String     @default("ok")
  /// De ce a fost oprit (filtrul automat sau administratorul).
  motivModerare       String?
  raportari           Raportare[]
  poze                Poza[]
  proprietarId        String
  proprietar          Utilizator @relation(fields: [proprietarId], references: [id], onDelete: Cascade)

  @@index([moderare])
  @@index([judet, oras, publicatLa])
  @@index([judet, oras, ordine])
  @@index([tranzactie, tip, pret])
  @@index([proprietarId, expiraLa])
}

model Sesiune {
  /// Hash SHA-256 al token-ului din cookie; token-ul în sine nu se salvează.
  id           String     @id
  utilizatorId String
  utilizator   Utilizator @relation(fields: [utilizatorId], references: [id], onDelete: Cascade)
  expiraLa     DateTime

  @@index([utilizatorId])
}

/// Invitație pentru o agenție: rezervă un loc de Agenție Fondatoare 14 zile.
model InvitatieAgentie {
  cod        String      @id
  /// Pentru cine e invitația (ex. numele agenției), doar ca notă internă.
  nota       String?
  creatLa    DateTime    @default(now())
  expiraLa   DateTime
  folositaDe String?     @unique
  folositaLa DateTime?
  agentie    Utilizator? @relation(fields: [folositaDe], references: [id], onDelete: SetNull)

  @@index([expiraLa])
}

/// O vizită nouă pe site (o dată pe sesiune de browser), cu sursa ei, pentru statistici.
model Vizita {
  id       Int      @id @default(autoincrement())
  creatLa  DateTime @default(now())
  sursa    String
  mediu    String?
  campanie String?
  pagina   String?

  @@index([creatLa, sursa])
}

/// Factură (sau storno) emisă de Hugetech SRL pentru o plată de pe site.
/// Seria și numărul le dă programul de facturare (Oblio), care ține numerotarea continuă
/// și trimite factura în e-Factura (SPV). Aici păstrăm evidența și legătura cu plata.
model Factura {
  id           Int         @id @default(autoincrement())
  creatLa      DateTime    @default(now())
  /// factura | storno
  tip          String      @default("factura")
  /// in-asteptare (neemisă încă) | emisa | eroare | stornata
  stare        String      @default("in-asteptare")
  /// Referința plății (comanda Netopia); una singură per plată, ca să nu facturăm de două ori.
  plataRef     String?     @unique
  utilizatorId String?
  utilizator   Utilizator? @relation(fields: [utilizatorId], references: [id], onDelete: SetNull)
  /// Datele cumpărătorului la momentul facturării (nume, cui, regCom, adresa, judet, oras, email).
  cumparator   Json
  /// Liniile facturii: [{ denumire, pretBani, cantitate }], prețuri cu TVA inclus.
  produse      Json
  /// Total cu TVA, în bani (1 leu = 100 bani).
  totalBani    Int
  cotaTva      Int         @default(0)
  seria        String?
  numar        String?
  emisaLa      DateTime?
  linkPdf      String?
  /// netrimisa | in-prelucrare | trimisa | eroare
  eFactura     String?
  eroare       String?
  /// Pentru storno: factura stornată.
  referintaId  Int?
  referinta    Factura?    @relation("Stornari", fields: [referintaId], references: [id], onDelete: Restrict)
  stornari     Factura[]   @relation("Stornari")

  @@unique([seria, numar])
  @@index([creatLa])
  @@index([stare])
  @@index([utilizatorId])
}

/// O comandă plătită cu cardul prin NETOPIA: o promovare pe un anunț sau un abonament de agenție.
model Comanda {
  /// Trimis la NETOPIA ca orderID și folosit ca plataRef pe factură.
  id           String     @id
  creatLa      DateTime   @default(now())
  utilizatorId String
  utilizator   Utilizator @relation(fields: [utilizatorId], references: [id], onDelete: Cascade)
  /// promovare | abonament
  tip          String
  /// Codul promovării sau al abonamentului (vezi src/lib/tarife.ts).
  produs       String
  anuntId      Int?
  anual        Boolean    @default(false)
  descriere    String
  /// Total cu TVA, în bani.
  sumaBani     Int
  /// noua | platita | respinsa
  stare        String     @default("noua")
  ntpID        String?
  platitaLa    DateTime?
  /// Ultimul cod de stare primit de la NETOPIA, pentru depanare.
  stareNetopia Int?

  @@index([utilizatorId, creatLa])
}

/// „Raportează anunțul”, trimis de vizitatori. O singură raportare per anunț și vizitator.
model Raportare {
  id       Int      @id @default(autoincrement())
  anuntId  Int
  anunt    Anunt    @relation(fields: [anuntId], references: [id], onDelete: Cascade)
  motiv    String
  detalii  String?
  /// Hash din IP + browser, ca același vizitator să nu raporteze de mai multe ori.
  amprenta String
  rezolvat Boolean  @default(false)
  creatLa  DateTime @default(now())

  @@unique([anuntId, amprenta])
  @@index([rezolvat])
}

/// O fotografie a unui anunț, stocată în afara Netlify (Cloudflare R2). Prima (ordine minimă) e coperta.
model Poza {
  id      Int      @id @default(autoincrement())
  anuntId Int
  anunt   Anunt    @relation(fields: [anuntId], references: [id], onDelete: Cascade)
  /// Cheia obiectului în stocare, ex. anunturi/123/abc.webp
  cheie   String   @unique
  ordine  Int      @default(0)
  creatLa DateTime @default(now())

  @@index([anuntId, ordine])
}
