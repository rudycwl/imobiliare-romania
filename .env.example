# Conexiunea PostgreSQL (local sau Neon / Supabase / Vercel Postgres în producție)
DATABASE_URL="postgresql://postgres@localhost:5432/imobiliare"
# Adresa publică, folosită în sitemap.xml
NEXT_PUBLIC_SITE_URL="https://cheiamea.ro"
# Administratori (emailuri separate prin virgulă): acces la /admin/...
ADMIN_EMAILS=""
# Facturare (Oblio): emailul contului Oblio și cheia din Oblio > Setări > Date cont.
OBLIO_EMAIL=""
OBLIO_SECRET=""
# Emitentul facturilor (Hugetech SRL) și seria definită în Oblio.
FACTURARE_CIF="39409800"
FACTURARE_SERIE="CHM"
# "da" doar dacă Hugetech SRL e plătitoare de TVA; cota implicită 21%.
FACTURARE_PLATITOR_TVA=""
FACTURARE_COTA_TVA="21"

# NETOPIA Payments (API v2). Cheia API: admin NETOPIA → Profil → Securitate.
# Cheia publică a punctului de vânzare (fișierul .cer), conținutul ca text sau base64; verifică notificările de plată.
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_PUBLIC_KEY=
# „da” doar după aprobarea punctului de vânzare; altfel plățile merg în sandbox.
NETOPIA_LIVE=

# Pozele anunțurilor: Cloudflare R2 (în afara Netlify). Bucket public prin domeniul din R2_PUBLIC_URL; CORS cu PUT de pe https://cheiamea.ro.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
