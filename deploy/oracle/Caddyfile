# CheiaMea pe Oracle Cloud. Caddy ia singur certificatele HTTPS când domeniile arată spre această mașină.
# 158-180-27-245.sslip.io = adresa serverului fără DNS (pentru configurare și test înainte de mutarea domeniului).
cheiamea.ro, nou.cheiamea.ro, 158-180-27-245.sslip.io {
	encode zstd gzip
	# Antete de securitate pentru toate paginile.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
		-Server
		-X-Powered-By
	}
	# Pozele anunțurilor, salvate pe disc de aplicație (POZE_DIR).
	handle_path /poze/* {
		root * /var/lib/cheiamea-poze
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# CSS/JS din toate versiunile publicate (copiate de actualizeaza.sh), ca paginile deschise să nu rămână fără design.
	@static {
		path /_next/static/*
		file {
			root /opt/cheiamea/web
		}
	}
	handle @static {
		root * /opt/cheiamea/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /configurare* {
		# Linkurile vechi cu ?cod= nu trebuie să trimită codul spre alte site-uri.
		header Referrer-Policy "no-referrer"
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
	handle_errors 502 503 {
		header Content-Type "text/html; charset=utf-8"
		respond "<h1>CheiaMea</h1><p>Site-ul se pregătește. Revino în câteva minute.</p>" 503
	}
}

www.cheiamea.ro, cheiamea.com, www.cheiamea.com {
	redir https://cheiamea.ro{uri} permanent
}
