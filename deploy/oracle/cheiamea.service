[Unit]
Description=CheiaMea (Next.js)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/cheiamea/curent

[Service]
User=cheiamea
WorkingDirectory=/opt/cheiamea/curent
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=127.0.0.1 POZE_DIR=/var/lib/cheiamea-poze COPII_DIR=/var/lib/cheiamea-copii
ExecStart=/usr/bin/node /opt/cheiamea/bin/cu-env.mjs /opt/cheiamea/curent/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
